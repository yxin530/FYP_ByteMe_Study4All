EXPO_PUBLIC_API_URL=http://localhost:3000

# Backend Supabase configuration. Required for authentication and material retrieval.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Backend LLM configuration (Google Gemini via OpenAI-compatible endpoint).
# Supported values: gemini, openai, or mock.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Or use LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# ElevenLabs configuration (required for Audio Lesson / Podcast generation).
ELEVENLABS_API_KEY=
# ELEVENLABS_DEFAULT_VOICE_ID=

# Optional backend settings.
PORT=3000
CORS_ORIGIN=*
API_JSON_LIMIT=1mb

# Optional mobile toggle retained for backwards compatibility; the Tutor now calls the backend directly.
EXPO_PUBLIC_TUTOR_API_ENABLED=true
