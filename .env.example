EXPO_PUBLIC_API_URL=http://localhost:3000

# Backend Supabase configuration. Required for authentication and material retrieval.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Backend LLM configuration. The backend sends grounded material excerpts to this provider.
# Supported values: openai (OpenAI-compatible /v1/chat/completions endpoint) or mock.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Optional backend settings.
PORT=3000
CORS_ORIGIN=*
API_JSON_LIMIT=1mb

# Optional mobile toggle retained for backwards compatibility; the Tutor now calls the backend directly.
EXPO_PUBLIC_TUTOR_API_ENABLED=true
